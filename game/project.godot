; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Insulano"
run/main_scene="uid://v8dup1iis1nx"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

BeehaveGlobalMetrics="*res://addons/beehave/metrics/beehave_global_metrics.gd"
BeehaveGlobalDebugger="*res://addons/beehave/debug/global_debugger.gd"
LLM="*res://llm/llm_bridge.gd"
NeedsManager="*res://world/needs_manager.gd"
AmbientAudio="*res://audio/ambient_audio.gd"
Clock="*res://world/game_clock.gd"
InputWatcher="*res://app/input_watcher.gd"
ArcHistory="*res://world/arc_history.gd"
Events="*res://events/event_director.gd"
Screensaver="*res://app/screensaver_mode.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/beehave/plugin.cfg", "res://addons/gut/plugin.cfg")

[global_group]

usableObjects=""
fishingSpot=""

[insulano]

llm/enabled=true
llm/url="http://127.0.0.1:11434"
llm/model="llama3.1:8b"
llm/timeout_s=8.0
llm/min_interval_s=30.0
debug/fake_time=""
weather/enabled=true
weather/location=""
events/seed=0
audio/enabled=true
audio/volume_db=0.0

[physics]

2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
